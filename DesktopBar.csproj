<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>YukiDesk</AssemblyName>
    <ApplicationIcon>Assets\YukiDesk.ico</ApplicationIcon>
    <RootNamespace>DesktopBar</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.7</Version>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- AMD Zen SMN 读取模块(LGPL-2.1,取自 LibreHardwareMonitor 资源,由 PawnIO 官方签名),供 PawnIoTctl 加载 -->
    <EmbeddedResource Include="Resources\PawnIo\AMDFamily17.bin" />
  </ItemGroup>

</Project>
