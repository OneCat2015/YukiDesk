<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="YukiDesk.app"/>
  <!-- 不声明 dpiAware:WinForms 构建集成禁止 manifest 携带 DPI 设置(WFAC010),
       且 DPI 感知由 WPF 启动时自行设定,与 v1.0.1–v1.0.7 无 manifest 时行为一致 -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- 回收站 $I 元数据可含超长路径:声明 longPathAware,配合系统 LongPathsEnabled 策略 -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
  <!-- 显式 asInvoker:与缺省一致,并杜绝任何目录下的自动提权 -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
