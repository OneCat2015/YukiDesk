<Window x:Class="DesktopBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="YukiDesk 设置" Width="940" Height="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="False" ShowInTaskbar="True"
        ResizeMode="CanResize" MinWidth="760" MinHeight="520">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="14"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowRoot" CornerRadius="14"
            Background="{DynamicResource SettingsWindowBackground}"
            BorderBrush="{DynamicResource SettingsWindowBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Grid.Row="0"
                    Background="{DynamicResource SettingsTitleBackground}"
                    MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="YukiDesk 设置" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource SettingsTextBrush}" Margin="18,0,0,0"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,14,0">
                        <Button Style="{StaticResource WindowCaptionButton}" Content="&#xE921;"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="最小化" Click="Minimize_Click"/>
                        <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="关闭" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="185"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,14,0,0">
                    <RadioButton Style="{StaticResource NavRadio}" Content="    外观" IsChecked="True"
                                 Checked="Nav_Checked" Tag="Appearance"/>
                    <RadioButton Style="{StaticResource NavRadio}" Content="    时间"
                                 Checked="Nav_Checked" Tag="Time"/>
                    <RadioButton Style="{StaticResource NavRadio}" Content="    小文件夹"
                                 Checked="Nav_Checked" Tag="Folders"/>
                    <RadioButton Style="{StaticResource NavRadio}" Content="    模块显示"
                                 Checked="Nav_Checked" Tag="Modules"/>
                    <RadioButton Style="{StaticResource NavRadio}" Content="    通用"
                                 Checked="Nav_Checked" Tag="General"/>
                    <RadioButton Style="{StaticResource NavRadio}" Content="    关于"
                                 Checked="Nav_Checked" Tag="About"/>
                </StackPanel>

                <Grid x:Name="PagesGrid" Grid.Column="1">
                    <ScrollViewer Tag="Appearance" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" RenderTransformOrigin="0.5,0.5">
                        <StackPanel x:Name="AppearanceHost" Margin="8,16,20,24"/>
                    </ScrollViewer>
                    <ScrollViewer Tag="Time" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                        <StackPanel x:Name="TimeHost" Margin="8,16,20,24"/>
                    </ScrollViewer>
                    <ScrollViewer Tag="Folders" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                        <StackPanel x:Name="FoldersHost" Margin="8,16,20,24"/>
                    </ScrollViewer>
                    <ScrollViewer Tag="Modules" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                        <StackPanel x:Name="ModulesHost" Margin="8,16,20,24"/>
                    </ScrollViewer>
                    <ScrollViewer Tag="General" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                        <StackPanel x:Name="GeneralHost" Margin="8,16,20,24"/>
                    </ScrollViewer>
                    <ScrollViewer Tag="About" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                        <StackPanel x:Name="AboutHost" Margin="8,16,20,24"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
